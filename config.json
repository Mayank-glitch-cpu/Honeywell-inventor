  },
  "twinmaker": {
    "workspace": {
      "id": "SimpleFactoryTwin",
      "description": "Simple manufacturing cell digital twin",
      "s3": {
        "bucket_name": "",
        "prefix": "simple-factory"
      },
      "role": {
        "name": "TwinMakerWorkspaceRole",
        "trust_policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "iottwinmaker.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "access_policies": [
          {
            "name": "TwinMakerS3Access",
            "document": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:ListBucket"
                  ],
                  "Resource": [
                    "arn:aws:s3:::{bucket_name}",
                    "arn:aws:s3:::{bucket_name}/*"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "components": {
      "motor": {
        "id": "MotorComponentType",
        "description": "Industrial motor with speed and power monitoring",
        "properties": {
          "Speed": {
            "dataType": "DOUBLE",
            "unitOfMeasure": "RPM",
            "isTimeSeries": false,
            "isRequiredInEntity": false
          },
          "PowerConsumption": {
            "dataType": "DOUBLE",
            "unitOfMeasure": "kW",
            "isTimeSeries": false
          },
          "Status": {
            "dataType": "STRING"
          },
          "SerialNumber": {
            "dataType": "STRING"
          },
          "MaintenanceDue": {
            "dataType": "STRING"
          }
        }
      }
    },
    "entities": {
      "motor": {
        "entityName": "motor-scripted-1",
        "entityId": "motor-scripted-1",
        "description": "Motor entity synchronized with SiteWise asset",
        "components": {
          "MotorComponent": {
            "componentTypeId": "MotorComponentType",
            "properties": {
              "Speed": {
                "doubleValue": 1750.0
              },
              "PowerConsumption": {
                "doubleValue": 5.5
              },
              "Status": {
                "stringValue": "RUNNING"
              },
              "SerialNumber": {
                "stringValue": "MOTOR-SCRIPTED-001"
              },
              "MaintenanceDue": {
                "stringValue": "2024-12-31"
              }
            }
          }
        }
      }
    }
  },
  "sitewise": {
    "model": {
      "name": "Motor-scripted",
      "description": "Motor model with serial number and speed measurement",
      "properties": [
        {
          "name": "Serial",
          "dataType": "STRING",
          "type": {
            "attribute": {
              "defaultValue": "DEFAULT-SERIAL-00001"
            }
          }
        },
        {
          "name": "Speed",
          "dataType": "DOUBLE",
          "unit": "RPM",
          "type": {
            "measurement": {}
          }
        }
      ]
    },
    "asset": {
      "name_template": "motor-scripted-{index}",
      "index": 1,
      "serial_template": "MOTOR-SCRIPTED-{asset_id}"
    }
  },
  "environment": {
    "venv_path": "venv-sitewise",
    "scripts": {
      "twinmaker_workspace": "run.sh",
      "sitewise_model": "run-sitewise-model.sh",
      "sitewise_asset": "run-sitewise-asset.sh",
      "twinmaker_entities": "run-twinmaker-entities.sh"
    }
  }
}